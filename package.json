    "audit:household-statistics": "node scripts/audit-household-statistics.mjs",
    "audit:data-review": "node scripts/audit-data-review.mjs && node scripts/test-data-review-observation.mjs",
    "audit:investor-profiles": "node scripts/audit-investor-profiles.mjs",
