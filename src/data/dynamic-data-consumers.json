{
  "version": 1,
  "bindings": [
    {
      "pattern": "src/pages/dca-profiles/holdings-*.json",
      "consumers": [
        "src/pages/dca-profiles/holdings-loader.js",
        "scripts/data-automation-inventory.mjs"
      ],
      "mechanism": "import.meta.glob ?url puis fetch ; inventaire : lecture des mêmes fragments et qualification par le moteur de recouvrement",
      "producer": "scripts/build-dca-exposures.mjs"
    },
    {
      "pattern": "src/data/dca-complete-holdings.json",
      "consumers": [
        "src/pages/dca-profiles/holdings-loader.js"
      ],
      "mechanism": "projection de build en fragments datés",
      "producer": "scripts/build-dca-exposures.mjs"
    },
    {
      "pattern": "src/data/dca-equity-exposures.json",
      "consumers": [
        "scripts/build-dca-exposures.mjs"
      ],
      "stage": "build",
      "mechanism": "prior projection used to preserve qualified equity rows",
      "producer": "scripts/build-dca-exposures.mjs"
    },
    {
      "pattern": "src/data/dca-holdings-status.json",
      "consumers": [
        "scripts/build-dca-exposures.mjs",
        "scripts/report-asset-fields.mjs",
        "scripts/build-index-company-compositions.mjs"
      ],
      "stage": "build",
      "mechanism": "dated admission and publication gates",
      "producer": "scripts/collect_dca_complete_holdings.py"
    },
    {
      "pattern": "src/data/dca-security-classifications.json",
      "consumers": [
        "scripts/build-dca-exposures.mjs",
        "scripts/build-equity-history-links.mjs"
      ],
      "stage": "build",
      "mechanism": "security identity projection and catalogue admission",
      "producer": null
    },
    {
      "pattern": "src/data/exposure-sleeves.json",
      "consumers": [
        "scripts/build-dca-exposures.mjs"
      ],
      "stage": "build",
      "mechanism": "economic exposure projection",
      "producer": "scripts/derive-exposure-sleeves.mjs"
    },
    {
      "pattern": "src/data/index-company-qualified.json",
      "consumers": [
        "scripts/build-index-company-compositions.mjs"
      ],
      "stage": "build",
      "mechanism": "qualified index composition projection",
      "producer": "scripts/build-index-company-compositions.mjs"
    },
    {
      "pattern": "src/data/instrument-metadata-status.json",
      "consumers": [
        "scripts/build-automation-targets.mjs",
        "scripts/report-asset-fields.mjs",
        "scripts/data-automation-inventory.mjs"
      ],
      "stage": "build",
      "mechanism": "field incidents and qualification reports",
      "producer": "scripts/collect_instrument_metadata.py"
    },
    {
      "pattern": "src/data/security-identifier-observations.json",
      "consumers": [
        "scripts/security_identifier_observations.py"
      ],
      "stage": "collection",
      "mechanism": "dated SEDOL/ISIN crosswalk; no weights imported",
      "producer": null
    },
    {
      "pattern": "src/pages/dca-profiles/holdings.json",
      "consumers": [
        "scripts/test-exposure-checker.mjs"
      ],
      "stage": "validation",
      "mechanism": "top-ten regression projection; not the runtime full holdings loader",
      "producer": "scripts/build-dca-exposures.mjs"
    },
    {
      "pattern": "reports/amundi-distributions-2026-10-23/official-response.json.gz",
      "consumers": [
        "scripts/qualified_distributions.py"
      ],
      "stage": "collection",
      "mechanism": "distributionEvidence in monthly-automation.json ; immutable historical cash and exact quote-unit evidence",
      "producer": null
    },
    {
      "pattern": "reports/amundi-distributions-2026-10-23/official-provenance.json",
      "consumers": [
        "scripts/qualified_distributions.py"
      ],
      "stage": "collection",
      "mechanism": "distributionEvidence in monthly-automation.json ; immutable historical cash and exact quote-unit evidence",
      "producer": null
    },
    {
      "pattern": "reports/reliquat-79-2026-10-23/preuves/marches-originaux/etfFR0007054358.json.gz",
      "consumers": [
        "scripts/qualified_distributions.py"
      ],
      "stage": "collection",
      "mechanism": "distributionEvidence in monthly-automation.json ; immutable historical cash and exact quote-unit evidence",
      "producer": null
    },
    {
      "pattern": "reports/amundi-distributions-2026-10-23/github-result.json",
      "consumers": [
        "scripts/build-review-reconciliation.mjs"
      ],
      "stage": "build",
      "mechanism": "immutable GitHub-validated cash-repair evidence; no live return substitution",
      "producer": null
    },
    {
      "pattern": "reports/wfns-dividend-2026-10-23/github-qualification/wfns-result.json",
      "consumers": [
        "scripts/build-review-reconciliation.mjs"
      ],
      "stage": "build",
      "mechanism": "immutable GitHub-validated cash-repair evidence; no live return substitution",
      "producer": null
    },
    {
      "pattern": "src/data/shared-listing-identities.json",
      "consumers": [
        "scripts/export-equity-candidates.mjs",
        "scripts/report-ai-tool-reuse.mjs"
      ],
      "stage": "build",
      "mechanism": "Preuves de cotation partagées transférées sans modifier identités, dates ou sources ; aucun historique IA utilisé",
      "producer": "scripts/refresh_qualified_listings.py"
    }
  ]
}
