od%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=3840&amp;q=75"/></div></div></div></div><div class="pointer-events-none relative z-10 flex min-w-0 flex-col gap-3 overflow-hidden"><p class="typ-caption-1 text-grey-400 mt-6 line-clamp-1" title="Aneeka Gupta">Aneeka Gupta</p><h4 class="typ-h4 text-navy-300 line-clamp-3 first:mt-4" title="El Niño and Iran war reshape agricultural commodities">El Niño and Iran war reshape agricultural commodities</h4><time dateTime="2026-10-06" class="typ-caption-2 text-grey-300">6 October 2026</time><p class="typ-body text-navy-300 line-clamp-3">El Niño is forecast to reach very strong intensity into 2027 while the Gulf conflict keeps fertiliser costs elevated. Agriculture has been a broad-based commodity beneficiary in 2026, but annual crops have led on geopolitics. With El Niño&#x27;s effects landing in 2027, the perennials may carry weather risks that are less reflected in 2026 price performance.</p><ul class="mt-4 list-none p-0 flex flex-wrap gap-2" aria-label="Tags"><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Agricultural Commodities</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Commodities</span></li></ul></div></div></a><a aria-label="What&#x27;s Hot: Wheat&#x27;s war premium returns" class="group relative block h-full focus:outline-none focus-visible:ring-2 focus-visible:ring-grey-100 focus-visible:ring-offset-2" href="/gb/insights/blog/wheats-war-premium-returns"><div class="border-grey-100 group-hover:border-grey-200 flex h-full flex-col border bg-white p-3 transition-colors duration-200 md:p-4"><div class="pointer-events-none relative h-52 w-full"><div class="relative h-full w-full overflow-hidden"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="object-cover transition-transform duration-500 ease-out group-hover:scale-105" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fgl