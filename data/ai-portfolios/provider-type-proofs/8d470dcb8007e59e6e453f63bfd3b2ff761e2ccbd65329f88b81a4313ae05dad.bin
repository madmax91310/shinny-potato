ript><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"94:T64a,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"95:T69e,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"96:T64a,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"97:T6a2,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"98:T64a,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"7a:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"typ-h3 py-4\",\"children\":\"Articles and Research Papers\"}],[\"$\",\"$L91\",null,{\"cards\":[{\"key\":\"blogPost-el-nino-and-iran-war-reshape-agricultural-commodities\",\"title\":\"El Niño and Iran war reshape agricultural commodities\",\"href\":\"/insights/blog/el-nino-and-iran-war-reshape-agricultural-commodities\",\"siteSlug\":\"wisdomtree-eu\",\"locale\":\"en-GB\",\"excerpt\":\"El Niño is forecast to reach very strong intensity into 2027 while the Gulf conflict keeps fertiliser costs elevated. Agriculture has been a broad-based commodity beneficiary in 2026, but annual crops have led on geopolitics. With El Niño's effects landing in 2027, the perennials may carry weather risks that are less reflected in 2026 price performance.\",\"heroImage\":{\"_type\":\"imageWithAlt\",\"asset\":{\"_ref\":\"image-2d34466fef23cf5dc82b1d331ebc36217ff5fe65-1151x564-jpg\",\"_type\":\"reference\"},\"media\":{\"_ref\":\"media-library:mlENc2IMivzo:38rIXeoV2woCcixdAHZEOGgr8xl\",\"_type\":\"globalDocumentReference\",\"_weak\":true}},\"imageAlt\":null,\"publishedAt\":\"2026-10-06T06:00:00.000Z\",\"tags\":[\"Agricultural Commodities\",\"Commodities\"],\"contributorThumbnails\":[{\"name\":\"Aneeka Gupta\",\"headshot\":{\"_type\":\"image\",\"alt\":