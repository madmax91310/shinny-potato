x1024.png\"},\"media\":{\"_ref\":\"media-library:mlENc2IMivzo:3Co5vouiLbKDXjpbhTLoeN3XmGP\",\"_type\":\"globalDocumentReference\",\"_weak\":true}}},{\"name\":\"Aneeka Gupta\",\"headshot\":{\"_type\":\"image\",\"alt\":\"Aneeka Gupta\",\"asset\":{\"_createdAt\":\"2026-04-24T14:06:03Z\",\"_id\":\"image-7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024-png\",\"_rev\":\"gIPNh3P3FkrEeWtJqzkRQI\",\"_type\":\"sanity.imageAsset\",\"_updatedAt\":\"2026-04-24T14:06:03Z\",\"assetId\":\"7db109fc94ae574ef6c937bdbd119a3156438bd7\",\"extension\":\"png\",\"media\":{\"_ref\":\"media-library:mlENc2IMivzo:image-7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024-png\",\"_type\":\"globalDocumentReference\",\"_weak\":true},\"metadata\":{\"_type\":\"sanity.imageMetadata\",\"blurHash\":\"e87,ocI;0M^P}@%1WVIpofxZ5Rs.=_I;EgEMoe$*RkR*E2oe%2NHIp\",\"dimensions\":{\"_type\":\"sanity.imageDimensions\",\"aspectRatio\":1,\"height\":1024,\"width\":1024},\"hasAlpha\":true,\"isOpaque\":false,\"lqip\":\"$94\",\"palette\":{\"_type\":\"sanity.imagePalette\",\"darkMuted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#59372f\",\"foreground\":\"#fff\",\"population\":0.45,\"title\":\"#fff\"},\"darkVibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#550e28\",\"foreground\":\"#fff\",\"population\":0.21,\"title\":\"#fff\"},\"dominant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#e6a885\",\"foreground\":\"#000\",\"population\":0.65,\"title\":\"#fff\"},\"lightMuted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#ccbca4\",\"foreground\":\"#000\",\"population\":0,\"title\":\"#fff\"},\"lightVibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#e6a885\",\"foreground\":\"#000\",\"population\":0.65,\"title\":\"#fff\"},\"muted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#a87057\",\"foreground\":\"#fff\",\"population\":0.59,\"title\":\"#fff\"},\"vibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#af6642\",\"foregrou