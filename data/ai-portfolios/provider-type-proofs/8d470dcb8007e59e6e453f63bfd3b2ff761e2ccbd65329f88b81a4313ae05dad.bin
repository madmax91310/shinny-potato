%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=3840&amp;q=75"/></div></div></div></div><div class="pointer-events-none relative z-10 flex min-w-0 flex-col gap-3 overflow-hidden"><p class="typ-caption-1 text-grey-400 mt-6 line-clamp-1" title="Aneeka Gupta">Aneeka Gupta</p><h4 class="typ-h4 text-navy-300 line-clamp-3 first:mt-4" title="What’s Hot: Cotton’s comeback">What’s Hot: Cotton’s comeback</h4><time dateTime="2026-04-24" class="typ-caption-2 text-grey-300">24 April 2026</time><p class="typ-body text-navy-300 line-clamp-3">Cotton has surged to two-year highs, driven by a structural shift from surplus to deficit, Iran-war-related polyester cost pressures, and a surge in speculative positioning. With global output falling ~4%, Chinese supply down 10%, and El Ni&amp;#241;o risk rising, the supply-demand balance is tightening materially.</p><ul class="mt-4 list-none p-0 flex flex-wrap gap-2" aria-label="Tags"><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Commodities</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Agricultural Commodities</span></li></ul></div></div></a></div></li></ul></div></div></div><div class="flex items-center justify-center gap-4"><button type="button" class="border-grey-200 text-navy-300 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border-2 transition hover:border-blue-300 hover:text-blue-300 focus:outline-none focus-visible:border-blue-300 focus-visible:text-blue-300" aria-label="Previous slide"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left -ml-px h-6 w-6" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button><button type="button" class="border-grey-200 text-navy-300 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border-2 transition hover:border-blue-300 hover:text-blue-300 focus:outline-none focus-visible:border-blue-300 focus-visible:text-blue-300" aria-label="Next slide"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right -mr-px h-6 w-6" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div></div><div class="hidden gap-5 lg:grid lg:grid-cols-4"><a aria-label="El Niño and Iran war reshape agricultural commodities" class="group relative block h-full focus:outline-none focus-visible:ring-2 focus-visible:ring-grey-100 focus-visible:ring-offset-2" href="/gb/insights/blog/el-nino-and-iran-war-reshape-agricultural-commodities"><div class="border-grey-100 group-hover:border-grey-200 flex h-full flex-col border bg-white p-3 transition-colors duration-200 md:p-4"><div class="pointer-events-none relative h-52 w-full"><div class="relative h-full w-full overflow-hidden"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="object-cover transition-transform duration-500 ease-out group-hover:scale-105" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F2d34466fef23cf5dc82b1d331ebc36217ff5fe65-1151x564.jpg%3Frect%3D75%2C0%2C1003%2C564%26w%3D960%26h%3D540%26fit%3Dcrop%26auto%3Dformat&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F2d34466fef23cf5dc82b1d331ebc36217ff5fe65-1151x564.jpg%3Frect%3D75%2C0%2C1003%2C564%26w%3D960%26h%3D540%26fit%3Dcrop%26auto%3Dformat&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F2d34466fef23cf5dc82b1d331ebc36217ff5fe65-1151x564.jpg%3Frect%3D75%2C0%2C1003%2C564%26w%3D960%2