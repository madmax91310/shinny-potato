uuiDVhdQWZTR2cFzAKVcJp3uLah\"],\"FundNavHistoryModalSuspense\"]\n"])</script><script>self.__next_f.push([1,"72:[\"$\",\"$12\",null,{\"fallback\":null,\"children\":\"$L77\"}]\n73:[\"$\",\"$L78\",null,{\"isAHTemplate\":false,\"banner\":{\"ticker\":\"WEAT/WEAP\",\"fundName\":null,\"ctaTicker\":\"WEAT\",\"variant\":\"eu\",\"primaryDocument\":{\"href\":\"https://dataspanapi.wisdomtree.com/pdr/documents/FACTSHEET/CSL/EU/EN-GB/JE00BN7KB664\",\"label\":\"Factsheet\",\"gated\":\"$undefined\"},\"secondaryDocument\":{\"href\":\"https://dataspanapi.wisdomtree.com/pdr/documents/PROSPECTUS/CSL/GB/EN-GB/JE00BN7KB664\",\"label\":\"Prospectus\",\"gated\":\"$undefined\"},\"documentLinks\":\"$undefined\",\"siteSlug\":\"wisdomtree-eu\"},\"links\":[{\"href\":\"#product-overview\",\"title\":\"Overview\"},{\"href\":\"#listings-codes\",\"title\":\"Listings and codes\"},{\"href\":\"#performance\",\"title\":\"Performance\"},{\"href\":\"#index-details\",\"title\":\"Index\"},{\"href\":\"#collateral-details\",\"title\":\"Collateral\"},{\"href\":\"#documents\",\"title\":\"Documents\"}]}]\n"])</script><script>self.__next_f.push([1,"74:[\"$\",\"div\",null,{\"className\":\"container-layout flex flex-col gap-10 py-10 lg:py-20\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"typ-h2\",\"children\":\"Overview\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"typ-h4\",\"children\":\"Product Description\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"453f07d8f85c\",{\"className\":\"typ-body-1 min-h-lh\",\"children\":[\"WisdomTree Wheat is a fully collateralised, UCITS eligible Exchange Traded Commodity (ETC) designed to provide investors with a total return exposure to Wheat futures contracts. The ETC aims to replicate the Bloomberg Commodity Wheat Subindex 4W Total Return Index (BCOMWH4T) by tracking the Bloomberg Wheat Sub Excess Return Index and providing the interest revenue adjusted to reflect fees and costs associated with the product. For example, if the Bloomberg Commodity Wheat Subindex 4W Total Return Index rises by 1% over a day, then the ETC will rise by 1%, excluding fees. However if the Bloomberg Commodity Wheat Subindex 4W Total Return Index falls by 1% over a day, then the ETC will fall by 1%, excluding fees.\"]}]]}]]}],false,[\"$\",\"$L79\",null,{\"siteSlug\":\"wisdomtree-eu\",\"text\":[{\"_key\":\"68f4f597c890\",\"_type\":\"block\",\"children\":[{\"_key\":\"72168a0764e9\",\"_type\":\"span\",\"marks\":[],\"text\":\"An investment in an ETP involves a degree of risk. Any decision to invest should be based on the information contained in the relevant prospectus. Prospective investors should obtain independent accounting, tax and legal advice and should consult their professional advisers to ascertain the suitability of this ETP as an investment to their own circumstances.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3194a6a63428\",\"_type\":\"block\",\"children\":[{\"_key\":\"eaebbf946865\",\"_type\":\"span\",\"marks\":[],\"text\":\"This ETP is structured as a debt security and not as shares (equity) and can be created and redeemed on demand by authorised participants and traded on exchange just like shares in a company. This ETP is not a UCITS product.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a9c44bcb3693\",\"_type\":\"block\",\"children\":[{\"_key\":\"6a6ee2599256\",\"_type\":\"span\",\"marks\":[],\"text\":\"Market Risk: The value of securities in this ETP is directly affected by increases and decreases in the value of the Index. Accordingly, the value of a security may go up or down and a security holder may lose some or all of the amount invested but can not lose more than the amount invested.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3a4390ac0ef7\",\"_type\":\"block\",\"children\":[{\"_key\":\"611e9d5b5e65\",\"_type\":\"span\",\"marks\":[],\"text\":\"Liquidity risk: There can be no certainty that securities can always be bought or sold on a stock exchange or that the market price at which the securities may be traded on a stock exchange will always accurately reflect the performance of the Index.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"876849901ae9\",\"_type\":\"block\",\"children\":[{\"_key\":\"606ae664e4b5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Counterparty risk: The Issuer is reliant on there being swap counterparties available to enter into swap agreements on a continuing basis and, if no swap counterparties are willing to do so, the ETP will not be able to achieve its investment policy of tracking the performance of the Index.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"949507a40b29\",\"_type\":\"block\",\"children\":[{\"_key\":\"40e795d52fb1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Credit Risk: The Issuer is subject to the risk that third party service providers may fail to return property or collateral belonging to the Issuer or pay money due to the issuer. The ETP is backed by swaps. The payment obligations of the swap counterparties to the Issuer are protected by collateral held which is marked to market daily. The collateral is held in segregated accounts at The Bank of New York Mellon. In the event a swap counterparty defaults, the proceeds from realisation of the collateral may be less than what the investor expects. Details of the collateral held can be found in the Collateral section of the WisdomTree website (www. Wisdomtree. Com).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"05b892656b96\",\"_type\":\"block\",\"children\":[{\"_key\":\"ff499dc9b7ea\",\"_type\":\"span\",\"marks\":[],\"text\":\"The performance of commodity indices may differ significantly from spot commodity prices, which are often quoted in the financial press, as the spot in itself is not investable. An investment in commodities may experience high volatility and should be considered as a longer term investment.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c7c513fdd3ae\",\"_type\":\"block\",\"children\":[{\"_key\":\"eda48e87937b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Please see the risks factors section of the Prospectus for a more detailed discussion of the potential risks\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"}],\"title\":\"Potential Risks\",\"forceExpanded\":\"$undefined\"}],\"$L7a\",null]}]\n"])</script><script>self.__next_f.push([1,"75:[[\"$\",\"div\",null,{\"id\":\"product-overview\",\"className\":\"bg-silver-150 scroll-mt-30\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-layout py-8 lg:py-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"typ-h3\",\"children\":\"Fund Overview\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 md:flex-row\",\"children\":[[\"$\",\"$L7b\",null,{\"columns\":[{\"id\":\"0\",\"name\":\"Product Overview\",\"isRowHeader\":true},{\"id\":\"1\",\"name\":\"As of 21/10/2026\",\"isRowHeader\":true}],\"rows\":[{\"0\":\"ISIN\",\"1\":\"JE00BN7KB664\",\"id\":1,\"rowClassName\":\"$undefined\",\"cellClassName\":\"$undefined\"},{\"0\":\"Asset Class\",\"1\":\"Commodities\",\"id\":2,\"rowClassName\":\"$undefined\",\"cellClassName\":\"$undefined\"},{\"0\":\"Base Currency\",\"1\":\"USD\",\"id\":3,\"rowClassName\":\"$undefined\",\"cellClassName\":\"$undefined\"},{\"0\":\"Inception Date\",\"1\":\"22 September 2006\",\"id\":4,\"rowClassName\":\"$undefined\",\"cellClassName\":\"$undefined\"},{\"0\":\"Currency Hedged\",\"1\":\"No – this product is not protected against adverse currency movements\",\"id\":5,\"rowClassName\":\"$undefined\",\"cellClassName\":\"$undefined\"},{\"0\":\"Physical Delivery\",\"1\"