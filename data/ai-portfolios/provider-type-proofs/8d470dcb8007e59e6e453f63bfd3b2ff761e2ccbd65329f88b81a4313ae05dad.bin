ttps%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F9b9496848be68634d6f86d6ae95373e28c5bddfd-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F9b9496848be68634d6f86d6ae95373e28c5bddfd-1024x1024.png%3Fw%3D128%26h%3D128%26fit%3Dcrop%26auto%3Dformat&amp;w=3840&amp;q=75"/></div></div></div></div><div class="pointer-events-none relative z-10 flex min-w-0 flex-col gap-3 overflow-hidden"><p class="typ-caption-1 text-grey-400 mt-6 line-clamp-1" title="Mobeen Tahir, Aneeka Gupta, Tobias Lazar">Mobeen Tahir, Aneeka Gupta, Tobias Lazar</p><h4 class="typ-h4 text-navy-300 line-clamp-3 first:mt-4" title="Commodity Outlook: The baton never drops but who carries it keeps changing">Commodity Outlook: The baton never drops but who carries it keeps changing</h4><time dateTime="2026-09-02" class="typ-caption-2 text-grey-300">2 September 2026</time><p class="typ-body text-navy-300 line-clamp-3">Gold and oil led 2026&#x27;s commodity rally before metals and now agriculture take the baton. This blog summarises the key messages from our recently published Commodity Outlook. This includes the Iran conflict&#x27;s lasting impact, tightening metals demand from AI and defence, El Niño risk to food prices, and why gold and broad commodity exposure still look attractive into 2027.</p><ul class="mt-4 list-none p-0 flex flex-wrap gap-2" aria-label="Tags"><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Commodities</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Broad Commodities</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Agricultural Commodities</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Precious Metals</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Energy Transition</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Energy Transition Metals</span></li><li class="typ-caption-2 border-grey-100 text-navy-300 inline-flex max-w-full items-center border px-2 py-1"><span class="truncate">Market Outlook</span></li></ul></div></div></a></div></li><li class="splide__slide pb-1"><div class="h-full"><a aria-label="What’s Hot: Cotton’s comeback" class="group relative block h-full focus:outline-none focus-visible:ring-2 focus-visible:ring-grey-100 focus-visible:ring-offset-2" href="/gb/insights/blog/cottons-comeback"><div class="border-grey-100 group-hover:border-grey-200 flex h-full flex-col border bg-white p-3 transition-colors duration-200 md:p-4"><div class="pointer-events-none relative h-52 w-full"><div class="relative h-full w-full overflow-hidden"><img alt="cotton.webp" loading="lazy" decoding="async" data-nimg="fill" class="object-cover transition-transform duration-500 ease-out group-hover:scale-105" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7e7030337f49612b41866f84c9753e7f61efd761-1151x564.webp%3Frect%3D75%2C0%2C1003%2C564%26w%3D960%26h%3D540%26fit%3Dcrop%26auto%3Dformat&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Ff8796olh%2Fglobal-prod%2F7e7030337f49612b41866f84c9753e7f61efd761-1151x564.webp%3Frect%3D75%2C0%2C1003%2C564%26w%3D960%26h%3D540%26fit%3Dcrop%26auto%3Dformat&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sa