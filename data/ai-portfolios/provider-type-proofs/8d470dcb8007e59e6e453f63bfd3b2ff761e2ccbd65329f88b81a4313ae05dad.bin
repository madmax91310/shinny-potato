d/7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png\",\"sha1hash\":\"7db109fc94ae574ef6c937bdbd119a3156438bd7\",\"size\":1165489,\"source\":{\"id\":\"3Co6QcpYqacgby75b2tq6CVoIpS\",\"name\":\"sanity-media-library\"},\"uploadId\":\"ml-link-VDraCSnUzMNTsQ1gubzcHbzGY0MOufV6\",\"url\":\"https://cdn.sanity.io/images/f8796olh/global-prod/7db109fc94ae574ef6c937bdbd119a3156438bd7-1024x1024.png\"},\"media\":{\"_ref\":\"media-library:mlENc2IMivzo:3Co6QcpYqacgby75b2tq6CVoIpS\",\"_type\":\"globalDocumentReference\",\"_weak\":true}}}],\"openInNewTab\":false},{\"key\":\"blogPost-wheats-war-premium-returns\",\"title\":\"What's Hot: Wheat's war premium returns\",\"href\":\"/insights/blog/wheats-war-premium-returns\",\"siteSlug\":\"wisdomtree-eu\",\"locale\":\"en-GB\",\"excerpt\":\"Wheat has rallied sharply as Black Sea disruptions tighten export capacity during the peak shipping window, while speculative investors remain net short. With El Niño threatening Southern Hemisphere supply and the forward curve still in contango, the market is pricing a war premium without fully positioning for a sustained shortage. \",\"heroImage\":{\"_type\":\"imageWithAlt\",\"asset\":{\"_ref\":\"image-2d34466fef23cf5dc82b1d331ebc36217ff5fe65-1151x564-jpg\",\"_type\":\"reference\"},\"media\":{\"_ref\":\"media-library:mlENc2IMivzo:38rIXeoV2woCcixdAHZEOGgr8xl\",\"_type\":\"globalDocumentReference\",\"_weak\":true}},\"imageAlt\":null,\"publishedAt\":\"2026-09-04T14:01:31.917Z\",\"tags\":[\"Agricultural Commodities\",\"Commodities\"],\"contributorThumbnails\":[{\"name\":\"Nitesh Shah\",\"headshot\":{\"_type\":\"image\",\"alt\":\"Nitesh Shah\",\"asset\":{\"_createdAt\":\"2026-04-24T14:01:57Z\",\"_id\":\"image-bef15aaee9bb61a7056c28d24bd86e172dc5c9dd-1024x1024-png\",\"_rev\":\"gIPNh3P3FkrEeWtJqzlmpB\",\"_type\":\"sanity.imageAsset\",\"_updatedAt\":\"2026-07-15T20:29:01Z\",\"assetId\":\"bef15aaee9bb61a7056c28d24bd86e172dc5c9dd\",\"extension\":\"png\",\"media\":{\"_ref\":\"media-library:mlENc2IMivzo:image-b