		isTabletBasedOnResolution: function () {
			const minTabletWidth = 768;
			// const maxTabletWidth = 1024;
			// Using 1032 as max width for tablets due to bigger tablets(ex: iPad Air 13)
			const maxTabletWidth = 1032;
			const screenWidth = window.screen.width;
			const screenHeight = window.screen.height;

			if (this.isLandscapeMode()) {
				return (screenHeight >= minTabletWidth);
			}

			return (screenWidth <= maxTabletWidth);
		},
		getDeviceType: function(UA = '') {
			const isTouch = this.isTouchDevice();
			if (!isTouch) {
				return 'desktop';
			}

			let userAgent = UA || navigator.userAgent || navigator.vendor || window.opera;
			if (typeof userAgent == 'string') {
				userAgent = userAgent.toLowerCase();
			}

			// Check for tablet devices based on user agent string
			if (/(ipad|tablet|(android(?!.*mobile))|(windows(?!.*phone)(.*touch))|kindle|playbook|silk|(puffin(?!.*(IP|AP|WP))))/i.test(userAgent)) {
				return 'tablet';
			}

			// Check for mobile devices based on user agent string
			if (/Mobile|iphone|ipod|android|ie|blackberry|fennec/i.test(userAgent)) {
				return 'mobile';
			}

			// Check for mobile devices based on screen resolution
			if (this.isMobileBasedOnResolution()) {
				return 'mobile';
			}

			// Check for tablet devices based on screen resolution
			if (this.isTabletBasedOnResolution()) {
				return 'tablet';
			}

			// Default to desktop
			return 'desktop';
		},
	};
	$(document).ready(function () {
		//Page View Data Layer Changes
		var currentDate = new Date(),
		dateTime = (currentDate.getMonth() + 1) + '/' + currentDate.getDate() + '/' + currentDate.getFullYear() + '-' + currentDate.getHours() + ':' + currentDate.getMinutes() + ':' + currentDate.getSeconds(),
		deviceType = deviceDetection.getDeviceType(),
		pageUrl = window.location.href,
		pagePath = window.location.hostname + window.location.pathname,
		protocol = window.location.protocol,
		hostname = window.location.hostname,
		pageDomain = protocol + '//' + hostname,
		pageName = window.location.hostname.replace(/^www\./, '') + window.location.pathname.replace(/\//g, ':'),		
		pageName = pageName.endsWith(':') ? pageName.slice(0, -1) : pageName,
		refferer = document.referrer,
		previousPageName = refferer ? refferer.replace(/^https?:\/\//, '').replace(/\//g, ':')  : "",
		previousPageName = previousPageName.endsWith(':') ? previousPageName.slice(0, -1) : previousPageName,
		parts = window.location.pathname.split('/').filter(part => part),
		siteSection = parts[2] || "",
		siteSubSection = parts[3] || "",
		siteSubSection2 = parts[4] || "",
		siteSubSection3 = parts[5] || "";
		adobeDataLayer.push ({
			"event":"pageview",                                                                                                
			"pageInfo":{
				"eventName":"pageview",
				"pageName": pageName,
				"pageTitle": "S&P 500®",
				"pageUrl": pageUrl,
				"pagePath": pagePath,
				"deviceType": deviceType,
				"division": "spdji",
				"pageLanguage":"en",
				"previousPageName": previousPageName,
				"pageDomain":pageDomain,
				"siteSection":siteSection,
				"siteSubSection":siteSubSection,
				"siteSubSection2":siteSubSection2,
				"siteSubSection3":siteSubSection3,
				"referrer":refferer,
				"dateTime":dateTime
			},
			"userInfo":{
				"loginStatus":(SPI.user && SPI.user.userState) ? "Logged In" : "Logged Out",
				"userID": (SPI.user && SPI.user.userState) ? SPI.user.userId : "null",
				"registrationType": (SPI.user && SPI.user.userState) ? "Site Registration" : "None"	
			},
		});
	});
</script></body>
